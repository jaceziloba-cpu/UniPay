# --- FedaPay Configuration ---
# Clé secrète API : sk_live_... (Production) ou sk_sandbox_... (Test)
FEDAPAY_SECRET_KEY=sk_sandbox_your_fedapay_secret_key
# Clé secrète Webhook FedaPay pour vérifier les signatures HMAC
FEDAPAY_WEBHOOK_SECRET=your_fedapay_webhook_secret

# --- CinetPay Configuration ---
# Clé API CinetPay (générée dans votre espace développeur CinetPay)
CINETPAY_API_KEY=your_cinetpay_api_key
# Identifiant Site ID attribué par CinetPay
CINETPAY_SITE_ID=your_cinetpay_site_id
# Clé secrète Webhook CinetPay pour la validation de notification
CINETPAY_SECRET_KEY=your_cinetpay_secret_key

# --- PayDunya Configuration ---
# Dashboard PayDunya > Setup > API Keys
PAYDUNYA_MASTER_KEY=your_paydunya_master_key
PAYDUNYA_PUBLIC_KEY=your_paydunya_public_key
PAYDUNYA_PRIVATE_KEY=your_paydunya_private_key
PAYDUNYA_TOKEN=your_paydunya_token
PAYDUNYA_WEBHOOK_SECRET=your_paydunya_webhook_secret

# --- Kkiapay Configuration ---
# Dashboard Kkiapay > API Keys
KKIAPAY_PUBLIC_KEY=your_kkiapay_public_key
KKIAPAY_PRIVATE_KEY=your_kkiapay_private_key
KKIAPAY_WEBHOOK_SECRET=your_kkiapay_webhook_secret

# --- Serveur & Webhooks ---
PORT=3000
NODE_ENV=development
